{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.murchalka.dev/v1/client-extension.schema.json",
  "title": "Murchalka signed Client Extension v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "extension", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "extension": { "$ref": "#/$defs/extension" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "id", "version", "targets", "mode", "componentTree", "actions", "accessibility", "localization", "fallbackComponent", "propertiesSchemaVersion", "eventsSchemaVersion"],
      "properties": {
        "apiVersion": { "const": "client.murchalka.dev/v1" },
        "kind": { "const": "ClientExtension" },
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "targets": { "$ref": "#/$defs/targets" },
        "mode": { "enum": ["declarative", "wasm"] },
        "componentDefinitions": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/componentDefinition" } },
        "componentTree": { "$ref": "#/$defs/component" },
        "actions": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/action" } },
        "accessibility": { "$ref": "#/$defs/accessibility" },
        "localization": { "$ref": "#/$defs/localization" },
        "fallbackComponent": { "$ref": "#/$defs/id" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "wasmBase64": { "type": "string", "contentEncoding": "base64", "maxLength": 699052 },
        "propertiesSchemaVersion": { "type": "integer", "minimum": 1 },
        "eventsSchemaVersion": { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        { "if": { "properties": { "mode": { "const": "wasm" } }, "required": ["mode"] }, "then": { "required": ["wasmBase64"] } },
        { "if": { "properties": { "mode": { "const": "declarative" } }, "required": ["mode"] }, "then": { "not": { "required": ["wasmBase64"] } } }
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component"],
      "properties": {
        "component": { "$ref": "#/$defs/id" },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "properties": { "type": "object", "maxProperties": 64, "additionalProperties": true },
        "children": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/component" } }
      }
    },
    "componentDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "propertiesSchemaVersion", "eventsSchemaVersion", "propertiesSchema", "eventsSchema", "template"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "integer", "minimum": 1 },
        "propertiesSchemaVersion": { "type": "integer", "minimum": 1 },
        "eventsSchemaVersion": { "type": "integer", "minimum": 1 },
        "propertiesSchema": { "$ref": "#/$defs/embeddedSchema" },
        "eventsSchema": { "$ref": "#/$defs/embeddedSchema" },
        "template": { "$ref": "#/$defs/component" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "handlerModule", "payloadSchemaVersion"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "handlerModule": { "$ref": "#/$defs/moduleId" },
        "payloadSchemaVersion": { "type": "integer", "minimum": 1 },
        "confirmation": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "liveRegion": { "enum": ["off", "polite", "assertive"] }
      }
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultLocale", "messages"],
      "properties": {
        "defaultLocale": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$", "maxLength": 35 },
        "messages": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": { "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
          "additionalProperties": { "type": "object", "maxProperties": 256, "additionalProperties": { "type": "string", "maxLength": 4096 } }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "ecdsa-p256-sha256" },
        "keyId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "value": { "type": "string", "contentEncoding": "base64", "minLength": 80, "maxLength": 128 }
      }
    },
    "embeddedSchema": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "required": ["type"],
      "properties": {
        "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
        "$id": { "type": "string", "format": "uri", "maxLength": 512 },
        "type": { "enum": ["object", "array", "string", "number", "integer", "boolean", "null"] }
      }
    },
    "targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["web", "desktop", "mobile", "xr"] } },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9-]*)+$", "maxLength": 160 },
    "moduleId": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$", "maxLength": 253 },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" }
  }
}
