{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.murchalka.dev/v1/profile.schema.json",
  "title": "Murchalka Runtime Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "modules", "bindings", "permissionsPolicy", "activation"],
  "properties": {
    "apiVersion": { "const": "profiles.murchalka.dev/v1" },
    "kind": { "const": "RuntimeProfile" },
    "metadata": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": { "id": { "$ref": "#/$defs/localId" }, "version": { "$ref": "#/$defs/semver" } }
    },
    "modules": {
      "type": "object", "additionalProperties": false, "required": ["required", "optional"],
      "properties": {
        "required": { "type": "array", "items": { "$ref": "#/$defs/requiredModule" } },
        "optional": { "type": "array", "items": { "$ref": "#/$defs/optionalModule" } }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["consumer", "provider"],
        "properties": {
          "consumer": {
            "type": "object", "additionalProperties": false, "minProperties": 1,
            "properties": { "module": { "$ref": "#/$defs/moduleId" }, "requirement": { "$ref": "#/$defs/localId" }, "category": { "$ref": "#/$defs/capabilityId" } },
            "oneOf": [ { "required": ["category"] }, { "required": ["module", "requirement"] } ]
          },
          "provider": {
            "type": "object", "additionalProperties": false, "required": ["module", "capability"],
            "properties": { "module": { "$ref": "#/$defs/moduleId" }, "capability": { "$ref": "#/$defs/capabilityId" }, "instance": { "$ref": "#/$defs/instanceId" } }
          }
        }
      }
    },
    "permissionsPolicy": {
      "type": "object", "additionalProperties": false, "required": ["trustedPublishers", "autoApprove"],
      "properties": {
        "trustedPublishers": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/moduleId" } },
        "autoApprove": {
          "type": "object", "additionalProperties": false, "required": ["dataClasses", "network"],
          "properties": {
            "dataClasses": { "type": "array", "uniqueItems": true, "items": { "enum": ["public", "internal", "personal", "sensitive", "restricted"] } },
            "network": { "type": "array", "items": { "type": "string", "format": "hostname" } }
          }
        }
      }
    },
    "activation": {
      "type": "object", "additionalProperties": false, "required": ["autoInstallMissingFromRegistry", "autoUpdateChannel"],
      "properties": { "autoInstallMissingFromRegistry": { "type": "boolean" }, "autoUpdateChannel": { "enum": ["stable", "beta", "dev", "none"] } }
    },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "requiredModule": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "$ref": "#/$defs/moduleId" }, "version": { "$ref": "#/$defs/versionRange" } } },
    "optionalModule": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "$ref": "#/$defs/moduleId" }, "version": { "$ref": "#/$defs/versionRange" } } },
    "moduleId": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$", "maxLength": 253 },
    "capabilityId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9-]*)+$", "maxLength": 160 },
    "localId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "instanceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "versionRange": { "type": "string", "minLength": 1, "maxLength": 128 },
    "extensions": { "type": "object", "propertyNames": { "pattern": "^[a-z0-9][a-z0-9.-]*\\.[a-z0-9][a-z0-9.-]*$" }, "additionalProperties": true }
  }
}
