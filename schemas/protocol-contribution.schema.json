{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.murchalka.dev/v1/protocol-contribution.schema.json",
  "title": "Murchalka Protocol Contribution v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "routeNamespace", "handler", "descriptor", "transports", "authentication", "streaming", "limits", "security"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$", "maxLength": 160 },
    "version": { "type": "integer", "minimum": 1 },
    "routeNamespace": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "handler": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$", "maxLength": 160 },
    "descriptor": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$", "maxLength": 512 },
    "transports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["http", "sse", "websocket", "stdio"] }
    },
    "authentication": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["none", "bearer", "oauth2", "mtls"] }
    },
    "streaming": { "enum": ["none", "server", "duplex"] },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxPayloadBytes", "maxConcurrency", "timeout"],
      "properties": {
        "maxPayloadBytes": { "type": "integer", "minimum": 1, "maximum": 4194304 },
        "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "timeout": { "type": "string", "pattern": "^[1-9][0-9]*(?:ms|s|m)$" },
        "maxStreams": { "type": "integer", "minimum": 1, "maximum": 4096 }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalContent", "privateNetwork"],
      "properties": {
        "externalContent": { "const": "untrusted" },
        "privateNetwork": { "enum": ["deny", "explicitAllowlist"] }
      }
    },
    "extensions": { "type": "object", "propertyNames": { "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$" } }
  }
}
