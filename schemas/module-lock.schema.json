{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.murchalka.dev/v1/module-lock.schema.json",
  "title": "Murchalka Module Lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "module", "resolvedAt", "runtimeVersion", "dependencies", "artifacts", "contracts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "module": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "bundleDigest"],
      "properties": { "id": { "$ref": "#/$defs/moduleId" }, "version": { "$ref": "#/$defs/semver" }, "bundleDigest": { "$ref": "#/$defs/sha256" } }
    },
    "resolvedAt": { "type": "string", "format": "date-time" },
    "runtimeVersion": { "$ref": "#/$defs/semver" },
    "bindingRevision": { "type": "integer", "minimum": 0 },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["requirement", "providerModule", "providerVersion", "capability", "capabilityVersion", "instance", "bindingRevision"],
        "properties": {
          "requirement": { "$ref": "#/$defs/localId" }, "providerModule": { "$ref": "#/$defs/moduleId" },
          "providerVersion": { "$ref": "#/$defs/semver" }, "capability": { "$ref": "#/$defs/capabilityId" },
          "capabilityVersion": { "$ref": "#/$defs/semver" }, "instance": { "$ref": "#/$defs/instanceId" },
          "bindingRevision": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["target", "id", "digest"],
        "properties": { "target": { "enum": ["runtime", "node", "client"] }, "id": { "$ref": "#/$defs/localId" }, "digest": { "$ref": "#/$defs/sha256" } }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "version", "schemaDigest"],
        "properties": { "id": { "$ref": "#/$defs/capabilityId" }, "version": { "$ref": "#/$defs/semver" }, "schemaDigest": { "$ref": "#/$defs/sha256" } }
      }
    },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "moduleId": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$", "maxLength": 253 },
    "capabilityId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9-]*)+$", "maxLength": 160 },
    "localId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "instanceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "extensions": { "type": "object", "propertyNames": { "pattern": "^[a-z0-9][a-z0-9.-]*\\.[a-z0-9][a-z0-9.-]*$" }, "additionalProperties": true }
  }
}
