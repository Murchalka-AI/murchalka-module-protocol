{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.murchalka.dev/v1/capability.schema.json",
  "title": "Murchalka Capability Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "request", "response", "semantics", "security", "errors"],
  "properties": {
    "apiVersion": { "const": "capabilities.murchalka.dev/v1" },
    "kind": { "const": "CapabilityContract" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "category"],
      "properties": {
        "id": { "$ref": "#/$defs/capabilityId" },
        "version": { "$ref": "#/$defs/semver" },
        "category": { "$ref": "#/$defs/capabilityId" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "request": { "$ref": "#/$defs/schemaReference" },
    "response": { "$ref": "#/$defs/schemaReference" },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interaction", "sideEffect", "idempotency", "streaming", "cancellation", "defaultTimeout", "maxPayloadBytes"],
      "properties": {
        "interaction": { "enum": ["requestResponse", "command", "serverStream", "clientStream", "duplexStream"] },
        "sideEffect": { "enum": ["none", "idempotent", "nonIdempotent"] },
        "idempotency": { "enum": ["readOnly", "optional", "required", "unsupported"] },
        "streaming": { "type": "boolean" },
        "cancellation": { "enum": ["required", "bestEffort", "unsupported"] },
        "defaultTimeout": { "$ref": "#/$defs/duration" },
        "maxPayloadBytes": { "type": "integer", "minimum": 1, "maximum": 4194304 }
      },
      "allOf": [
        {
          "if": { "properties": { "sideEffect": { "const": "nonIdempotent" } }, "required": ["sideEffect"] },
          "then": { "properties": { "idempotency": { "const": "required" } } }
        }
      ]
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputDataClasses", "outputDataClasses", "requiredPurpose"],
      "properties": {
        "inputDataClasses": { "$ref": "#/$defs/dataClasses" },
        "outputDataClasses": { "$ref": "#/$defs/dataClasses" },
        "requiredPurpose": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "retryable"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "retryable": { "type": "boolean" },
          "description": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      },
      "maxItems": 128
    },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "capabilityId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9-]*)+$", "maxLength": 160 },
    "duration": { "type": "string", "pattern": "^[1-9][0-9]*(?:ms|s|m|h|d)$" },
    "schemaReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema"],
      "properties": { "schema": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$", "maxLength": 512 } }
    },
    "dataClasses": {
      "type": "array",
      "items": { "enum": ["public", "internal", "personal", "sensitive", "restricted"] },
      "uniqueItems": true,
      "maxItems": 5
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9.-]*\\.[a-z0-9][a-z0-9.-]*$" },
      "additionalProperties": true
    }
  }
}
