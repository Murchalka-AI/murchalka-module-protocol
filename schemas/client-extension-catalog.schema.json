{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.murchalka.dev/v1/client-extension-catalog.schema.json",
  "title": "Murchalka Client Extension Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "generatedAt", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["extensionId", "extensionVersion", "moduleId", "moduleVersion", "artifactId", "artifactDigest", "artifactBytes", "artifactUrl", "mode", "targets", "publisher", "keyId", "fallbackComponent"],
        "properties": {
          "extensionId": { "$ref": "#/$defs/id" }, "extensionVersion": { "$ref": "#/$defs/semver" },
          "moduleId": { "$ref": "#/$defs/moduleId" }, "moduleVersion": { "$ref": "#/$defs/semver" },
          "artifactId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "artifactDigest": { "$ref": "#/$defs/sha256" }, "artifactBytes": { "type": "integer", "minimum": 1, "maximum": 2097152 },
          "artifactUrl": { "type": "string", "pattern": "^/client/v1/artifacts/[a-f0-9]{64}$" },
          "mode": { "enum": ["declarative", "wasm"] },
          "targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["web", "desktop", "mobile", "xr"] } },
          "publisher": { "$ref": "#/$defs/moduleId" }, "keyId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
          "fallbackComponent": { "$ref": "#/$defs/id" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9-]*)+$", "maxLength": 160 },
    "moduleId": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$", "maxLength": 253 },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
